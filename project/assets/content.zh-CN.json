  "cards": [
    {
      "file": "01_assess_call",
      "title": "判断与呼救",
      "tag": "先确保安全，再立即求助",
      "steps": [
        "确认周围安全，拍肩大声呼叫",
        "无反应：呼叫 120，开启免提",
        "请旁人取 AED，听从调度指导",
        "观察呼吸 ≤10 秒，无正常呼吸即开始 CPR"
      ],
      "note": "濒死喘息也不是正常呼吸",
      "source_ids": [
        "aha_bls_2025",
        "nhc_120"
      ]
    },
    {
      "file": "02_compressions",
      "title": "胸外按压",
      "tag": "掌根置于胸骨下半部",
      "steps": [
        "双手叠放，双臂伸直，垂直下压",
        "成人频率：100–120 次/分",
        "深度至少 5 cm，避免超过 6 cm",
        "每次充分回弹，中断尽量 <10 秒"
      ],
      "note": "多人施救时约每 2 分钟轮换",
      "source_ids": [
        "aha_bls_2025"
      ]
    },
    {
      "file": "03_airway_breaths",
      "title": "气道与人工呼吸",
      "tag": "受训且愿意通气者：30 : 2",
      "steps": [
        "无颈部创伤时，仰头抬颏开放气道",
        "按压 30 次，再进行 2 次人工呼吸",
        "每次约 1 秒，以可见胸廓起伏为度",
        "未受训或不能通气：持续胸外按压"
      ],
      "note": "人工呼吸后立即恢复按压",
      "source_ids": [
        "aha_bls_2025",
        "aha_what_cpr"
      ]
    },
    {
      "file": "04_aed",
      "title": "使用 AED",
      "tag": "开机，贴片，听从设备提示",
      "steps": [
        "贴于裸露胸部，擦干胸壁、避开心脏起搏器",
        "分析心律及电击时，所有人离开",
        "是否电击由 AED 判断，按提示操作",
        "电击后或无需电击：立即恢复按压"
      ],
      "note": "恢复 CPR，遵循后续提示",
      "source_ids": [
        "rcuk_bls_2025"
      ]
    }
  ],
