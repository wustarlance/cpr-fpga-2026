# 自研文本使用 LF；厂商文件和加密 HDL 保留原始字节。
# 规则按顺序匹配，后面的例外覆盖通用设置。


# 自研源码、脚本与文档
*.v         text eol=lf
*.sv        text eol=lf
*.vh        text eol=lf
*.tcl       text eol=lf
*.sdc       text eol=lf
*.adc       text eol=lf
*.cwc       text eol=lf
*.ipc       text eol=lf
*.al        text eol=lf
*.md        text eol=lf
*.py        text eol=lf
*.json      text eol=lf
*.sh        text eol=lf
*.mem       text eol=lf
*.txt       text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf

# 厂商目录：-text 禁止行尾转换，此时 eol 属性不生效。
project/vendor/hdmi_lab/**  -text
project/vendor/** -text
project/ip/**     -text
DEMO/**           -text
99_归档/**        -text

# 加密 HDL：行尾变化会破坏密文。
*.enc.v           -text

# 与参考例程对照的派生文件保留原行尾。
project/rtl/cpr_overlay.v               -text
project/rtl/top/top_tf_hdmi_audio.v     -text
project/rtl/video_rgb_to_axis_640x480.v -text
project/constraints/pin.adc             -text

# 二进制资源
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.bmp  binary
*.bit  binary
*.pdf  binary
*.docx binary
*.vvp  binary
*.db   binary
*.zip  binary
*.wav  binary

# 仿真入口与厂商目录的空白检查例外
tests/sim/run.sh text eol=lf
project/ip/** -whitespace
project/vendor/** -whitespace
